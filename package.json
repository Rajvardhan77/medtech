{
  "name": "medlens-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate --workspace=@medlens/api",
    "db:migrate": "npm run db:migrate --workspace=@medlens/api"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
