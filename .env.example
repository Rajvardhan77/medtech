# Environment variables for MedLens local development

# PostgreSQL database connection
DATABASE_URL="postgresql://username:password@localhost:5432/medlens?schema=public"

# App & Auth Secrets (Generate strong random keys for production)
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"
APP_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"

# Anthropic Claude API (Used strictly server-side in /apps/api)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Object Storage / Upload configuration
STORAGE_DRIVER="local" # local | s3
LOCAL_UPLOAD_DIR="./uploads"
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Server Ports
PORT=4000
FRONTEND_URL="http://localhost:3000"
